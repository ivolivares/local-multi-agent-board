{
  "name": "local-board",
  "version": "0.1.1",
  "description": "Local Multi-Agent Board CLI (lb) & local board server to interconnect Claude Code, Grok, Gemini CLI, Antigravity, and local LLM agents.",
  "type": "module",
  "license": "MIT",
  "author": {
    "name": "Iván Olivares",
    "url": "https://iolivares.com"
  },
  "homepage": "https://github.com/ivolivares/local-multi-agent-board/tree/main/packages/local-board",
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "lb": "./bin/lb.mjs",
    "local-board": "./bin/lb.mjs"
  },
  "main": "./src/index.mjs",
  "exports": {
    ".": "./src/index.mjs",
    "./store": "./src/store.mjs",
    "./server": "./src/server.mjs",
    "./setup": "./src/setup.mjs",
    "./interactive": "./src/interactive.mjs"
  },
  "files": [
    "bin",
    "src",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=18.18.0"
  },
  "keywords": [
    "local-board",
    "local-multi-agent-board",
    "lb",
    "multi-agent",
    "board-protocol",
    "claude-code",
    "grok",
    "gemini",
    "antigravity",
    "cli",
    "cliui",
    "agent-coordination"
  ],
  "scripts": {
    "start": "node ./bin/lb.mjs",
    "serve": "node ./bin/lb.mjs serve --port 4100 --dir .board --attach",
    "ui": "node ./bin/lb.mjs ui",
    "attach": "node ./bin/lb.mjs attach",
    "setup": "node ./bin/lb.mjs setup",
    "conformance": "node ./bin/lb.mjs conformance",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "@poppinss/cliui": "^6.8.1"
  }
}
